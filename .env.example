# Copy to .env and fill what you have. Any service with missing keys is skipped.
# Run ./preflight.sh after filling to see what's green.

# --- Claude (askClaude, analyzeFrame, sopToRules, shift summary) ---
ANTHROPIC_API_KEY=sk-ant-...
# optional; only "claude" is implemented right now
VISION_PROVIDER=claude

# --- You: where test messages / calls / invites land ---
MY_EMAIL=you@example.com
MY_PHONE=+15551234567

# --- Linear (shared board; FREE TEST workspace only) ---
# Settings > Security & access > Personal API keys
LINEAR_API_KEY=lin_api_...

# --- Slack (YOUR test workspace) ---
# Bot scopes: chat:write chat:write.customize channels:read channels:history channels:manage channels:join users:read
#   app_mentions:read im:history im:read im:write reactions:read reactions:write
# Events (Socket Mode): app_mention message.channels message.im reaction_added
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode app-level token (scope connections:write)
SLACK_APP_TOKEN=xapp-...

# --- Telegram (sendTelegram, vision alerts) ---
# Bot token from @BotFather. Chat ID: message your bot, then run: node scripts/chat-id.js
# Comma-separate to alert several chats (you + a judge).
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# --- Email (sendEmail): Resend first, Gmail SMTP fallback ---
RESEND_API_KEY=re_...
# Sender must be on a verified Resend domain; onboarding@resend.dev works for sending to your own account email
RESEND_FROM=onboarding@resend.dev
GMAIL_USER=you@gmail.com
# Google Account > Security > 2-Step Verification > App passwords (16 chars, no spaces)
GMAIL_APP_PASSWORD=

# --- SMS (sendSMS) + inbound SMS/call webhook: Twilio ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164
TWILIO_FROM=+15557654321

# --- AI phone call (placeAICall): Vapi first, Retell fallback ---
VAPI_API_KEY=
# Dashboard > Phone Numbers > the number's ID (not the number itself)
VAPI_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_FROM_NUMBER=+15557654321
# Public URL the call agent's mid-call tool hits (ngrok or Vercel), e.g. https://abc.ngrok-free.app
PUBLIC_URL=

# --- Booking (createBooking): Cal.com first, .ics-by-email fallback ---
CALCOM_API_KEY=cal_live_...
# Numeric ID of the event type to book (Cal.com > Event Types > open one, ID is in the URL)
CALCOM_EVENT_TYPE_ID=

# --- Payments (createPaymentLink): Stripe TEST mode only ---
STRIPE_SECRET_KEY=sk_test_...

# --- Slack (postToSlack) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Scraping (scrapeUrl): Firecrawl first, plain fetch fallback ---
FIRECRAWL_API_KEY=fc-...

# --- Deploy / tunnel (optional; CLI login also works) ---
VERCEL_TOKEN=
NGROK_AUTHTOKEN=

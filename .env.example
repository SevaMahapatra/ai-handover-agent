# Copy to .env and fill in. Use TEST workspaces only (no live accounts). Check with: ./preflight.sh

# Claude: the dispatcher, each person's AI, the honesty-checked drafts
ANTHROPIC_API_KEY=sk-ant-...

# Linear: the shared record (writes only to the team with key ZAP)
# Settings > Security & access > Personal API keys
LINEAR_API_KEY=lin_api_...

# Slack: create the app from kit/slack-manifest.yaml (bot scopes, events, Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
# App-level token for Socket Mode (scope connections:write)
SLACK_APP_TOKEN=xapp-...

# Gmail: approved emails + .ics invites are delivered HERE only (pack addresses end in .example)
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Optional: minutes between handover cycles (default 5)
CYCLE_MINUTES=5
